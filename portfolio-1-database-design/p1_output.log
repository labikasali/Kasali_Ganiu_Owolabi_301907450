                                                                        Table "public.rental"
      Column      |           Type           | Collation | Nullable |                  Default                  | Storage  | Compression | Stats target | Description 
------------------+--------------------------+-----------+----------+-------------------------------------------+----------+-------------+--------------+-------------
 rental_id        | bigint                   |           | not null | nextval('rental_rental_id_seq'::regclass) | plain    |             |              | 
 car_id           | bigint                   |           | not null |                                           | plain    |             |              | 
 customer_id      | bigint                   |           | not null |                                           | plain    |             |              | 
 pickup_branch_id | bigint                   |           | not null |                                           | plain    |             |              | 
 return_branch_id | bigint                   |           | not null |                                           | plain    |             |              | 
 pickup_time      | timestamp with time zone |           | not null |                                           | plain    |             |              | 
 return_time      | timestamp with time zone |           | not null |                                           | plain    |             |              | 
 start_mileage    | integer                  |           | not null |                                           | plain    |             |              | 
 end_mileage      | integer                  |           | not null |                                           | plain    |             |              | 
 status           | text                     |           | not null | 'booked'::text                            | extended |             |              | 
 rental_range     | tstzrange                |           |          |                                           | extended |             |              | 
Indexes:
    "rental_pkey" PRIMARY KEY, btree (rental_id)
    "excl_no_overlapping_rental" EXCLUDE USING gist (car_id WITH =, rental_range WITH &&)
    "idx_rental_car" btree (car_id)
    "idx_rental_customer" btree (customer_id)
    "idx_rental_pickup_br" btree (pickup_branch_id)
    "idx_rental_pickup_time" btree (pickup_time)
    "idx_rental_range_gist" gist (rental_range)
    "idx_rental_return_br" btree (return_branch_id)
Check constraints:
    "chk_mileage_monotonic" CHECK (end_mileage >= start_mileage)
    "chk_return_after_pickup" CHECK (return_time > pickup_time)
    "rental_end_mileage_check" CHECK (end_mileage >= 0)
    "rental_start_mileage_check" CHECK (start_mileage >= 0)
    "rental_status_check" CHECK (status = ANY (ARRAY['booked'::text, 'active'::text, 'returned'::text, 'cancelled'::text]))
Foreign-key constraints:
    "rental_car_id_fkey" FOREIGN KEY (car_id) REFERENCES car(car_id) ON DELETE RESTRICT
    "rental_customer_id_fkey" FOREIGN KEY (customer_id) REFERENCES customer(customer_id)
    "rental_pickup_branch_id_fkey" FOREIGN KEY (pickup_branch_id) REFERENCES branch(branch_id)
    "rental_return_branch_id_fkey" FOREIGN KEY (return_branch_id) REFERENCES branch(branch_id)
Referenced by:
    TABLE "damage_report" CONSTRAINT "damage_report_rental_id_fkey" FOREIGN KEY (rental_id) REFERENCES rental(rental_id) ON DELETE CASCADE
    TABLE "payment" CONSTRAINT "payment_rental_id_fkey" FOREIGN KEY (rental_id) REFERENCES rental(rental_id) ON DELETE CASCADE
Triggers:
    trg_licence_valid_on_pickup BEFORE INSERT OR UPDATE OF pickup_time, customer_id ON rental FOR EACH ROW EXECUTE FUNCTION fn_licence_valid_on_pickup()
    trg_no_rental_during_maintenance BEFORE INSERT OR UPDATE OF rental_range, car_id ON rental FOR EACH ROW EXECUTE FUNCTION fn_no_rental_during_maintenance()
    trg_set_rental_range BEFORE INSERT OR UPDATE OF pickup_time, return_time ON rental FOR EACH ROW EXECUTE FUNCTION fn_set_rental_range()
    trg_sync_car_status AFTER INSERT OR UPDATE OF status ON rental FOR EACH ROW EXECUTE FUNCTION fn_sync_car_status()
